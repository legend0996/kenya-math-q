# ============================================================
# Kenya Math Quest — Backend environment (copy to .env)
# Everything is read from environment variables — no hardcoded config.
# ============================================================

# ── MySQL database ─────────────────────────────────────────
# Preferred: a single connection URL. Used when set (takes precedence
# over the individual DB_* credentials below). Supports:
#   DATABASE_URL=mysql://user:pass@host:3306/dbname
#   MYSQL_URL=mysql://user:pass@host:3306/dbname
#DATABASE_URL=mysql://kredocha_Adminmath:Math%402026@localhost:3306/kredocha_mathquest
# Individual credentials — only used when no DATABASE_URL/MYSQL_URL is set.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=kmq
# Max concurrent connections in the pool (raise for 3000+ users)
DB_POOL_MAX=50
# Set to true when the MySQL server requires TLS
DB_SSL=false
# Optional CA certificate path/content when DB_SSL=true
DB_SSL_CA=

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Public URL of the backend (used for M-Pesa callbacks)
PUBLIC_URL=https://api.kenyamathquest.co.ke
# Comma-separated allowed frontend origins (CORS + cookies)
FRONTEND_ORIGINS=https://kenyamathquest.co.ke
# Secret used to sign JWTs — use a long random string, never commit it
JWT_SECRET=generate-a-long-random-string

# ── Email (hosting SMTP) — all values come from env ─────────
SMTP_HOST=smtp.yourhosting.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=noreply@kenyamathquest.co.ke
EMAIL_PASS=
# "From" address + display name shown to recipients
EMAIL_FROM=noreply@kenyamathquest.co.ke
EMAIL_NAME=Kenya Math Quest

# ── M-Pesa Daraja STK push (optional) ──────────────────────
# Leave blank to use manual proof submission instead.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# sandbox | production
MPESA_ENV=sandbox
MPESA_AMOUNT=100

# ---- AI Assistant (chatbot) - optional ----
# Leave blank to keep the built-in knowledge-base assistant (no external calls).
# OPENAI_BASE_URL can override the endpoint (works with OpenAI-compatible hosts).
OPENAI_API_KEY=sk-abcdef1234567890abcdef1234567890abcdef12
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
